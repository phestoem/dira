# /etc/qusaz/dira-backup.env  (owner root or qusaz, chmod 600). Read by dira-backup.sh and dira-restore-test.sh.
DB_NAME=dira
PG_CONTAINER=qusaz-postgres
PG_USER=postgres
BACKUP_ROOT=/opt/qusaz/backups/dira
KEEP_DAILY=7
KEEP_WEEKLY=4
WEEKLY_DAY=7

# Other NUC (rsync over ssh with a dedicated key). Leave NUC_TARGET empty to skip.
NUC_TARGET=backup@OTHER_NUC_HOST:/srv/backups/dira
NUC_SSH_KEY=/home/qusaz/.ssh/dira_backup_ed25519

# Cloudflare R2 via restic (S3 API). Leave RESTIC_REPOSITORY empty to skip.
RESTIC_REPOSITORY=s3:https://R2_ACCOUNT_ID.r2.cloudflarestorage.com/dira-backups
RESTIC_PASSWORD_FILE=/etc/qusaz/dira-restic.pass
AWS_ACCESS_KEY_ID=R2_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=R2_SECRET_ACCESS_KEY
